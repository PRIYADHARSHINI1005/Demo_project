function ApplicationStepper({ step, setStep }) {
  return (
    <div className="stepper">
      <div className="step-section">
        <button
          type="button"
          className={
            step === 1
              ? "step-circle current"
              : "step-circle completed"
          }
          onClick={() => setStep(1)}
        >
          {step > 1 ? "✓" : "1"}
        </button>

        <p>Personal Details</p>
      </div>

      <div
        className={
          step > 1 ? "step-line completed-line" : "step-line"
        }
      ></div>

      <div className="step-section">
        <button
          type="button"
          className={
            step === 2
              ? "step-circle current"
              : step > 2
              ? "step-circle completed"
              : "step-circle"
          }
          onClick={() => setStep(2)}
          disabled={step < 2}
        >
          {step > 2 ? "✓" : "2"}
        </button>

        <p>Loan Details</p>
      </div>

      <div
        className={
          step > 2 ? "step-line completed-line" : "step-line"
        }
      ></div>

      <div className="step-section">
        <button
          type="button"
          className={
            step === 3
              ? "step-circle current"
              : step > 3
              ? "step-circle completed"
              : "step-circle"
          }
          onClick={() => setStep(3)}
          disabled={step < 3}
        >
          {step > 3 ? "✓" : "3"}
        </button>

        <p>Documents</p>
      </div>

      <div
        className={
          step > 3 ? "step-line completed-line" : "step-line"
        }
      ></div>

      <div className="step-section">
        <button
          type="button"
          className={
            step === 4
              ? "step-circle current"
              : "step-circle"
          }
          onClick={() => setStep(4)}
          disabled={step < 4}
        >
          4
        </button>

        <p>Review</p>
      </div>
    </div>
  );
}

export default ApplicationStepper;
