.loan-comments-page {
  width: 100%;
  min-height: 100vh;
  padding: 32px;
  background-color: #d4d4d4;
  color: #001e8c;
  box-sizing: border-box;
}

.loan-comments-page * {
  box-sizing: border-box;
}

.loan-comments-container {
  width: 100%;
  max-width: 1050px;
  margin: 0 auto;
}

.comments-page-heading {
  margin-bottom: 25px;
}

.comments-page-heading h1 {
  margin: 0 0 8px;
  color: #001e8c;
  font-size: 30px;
}

.comments-page-heading p {
  margin: 0;
  color: #0473ea;
}

.application-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-bottom: 28px;
  border: 1px solid #d4d4d4;
  border-radius: 7px;
  padding: 22px;
  background-color: #ffffff;
}

.application-summary div {
  display: flex;
  border-right: 1px solid #d4d4d4;
  padding: 0 20px;
  flex-direction: column;
}

.application-summary div:first-child {
  padding-left: 0;
}

.application-summary div:last-child {
  border-right: none;
}

.application-summary span {
  margin-bottom: 8px;
  color: #0473ea;
  font-size: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

.application-summary strong {
  color: #001e8c;
}

.application-summary .summary-status {
  color: #d50000;
}

.maker-comments-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.maker-comments-heading h2 {
  margin: 0;
  color: #001e8c;
}

.maker-comments-heading span {
  border-radius: 15px;
  padding: 6px 13px;
  background-color: #0473ea;
  color: #ffffff;
  font-size: 12px;
}

.comments-list {
  display: grid;
  gap: 20px;
}

.comment-card {
  border: 1px solid #d4d4d4;
  border-left: 5px solid #0473ea;
  border-radius: 6px;
  padding: 24px;
  background-color: #ffffff;
}

.comment-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.comment-card-header h3 {
  margin: 0 0 8px;
  color: #001e8c;
}

.maker-badge {
  display: inline-block;
  border-radius: 12px;
  padding: 4px 10px;
  background-color: #0473ea;
  color: #ffffff;
  font-size: 11px;
  font-weight: bold;
}

.comment-date {
  margin: 0;
  color: #0473ea;
  font-size: 13px;
}

.comment-message {
  margin: 22px 0;
  border: 1px solid #d4d4d4;
  border-radius: 4px;
  padding: 16px;
  background-color: #ffffff;
  color: #001e8c;
  line-height: 1.6;
}

.comment-details {
  display: flex;
  gap: 35px;
  align-items: center;
}

.comment-details p {
  margin: 0;
  color: #001e8c;
}

.action-status {
  color: #d50000;
  font-weight: bold;
}

.modify-button {
  display: block;
  min-width: 180px;
  margin-top: 22px;
  margin-left: auto;
  border: 2px solid #05561c;
  border-radius: 4px;
  padding: 12px 22px;
  background-color: #05561c;
  color: #ffffff;
  cursor: pointer;
  font-weight: bold;
}

.modify-button:hover {
  border-color: #38d200;
  background-color: #38d200;
  color: #001e8c;
}

.no-comments {
  border: 1px solid #d4d4d4;
  padding: 40px;
  background-color: #ffffff;
  color: #001e8c;
  text-align: center;
}

.edit-application-id {
  color: #0473ea;
}

.back-comments-button {
  margin-top: 20px;
  border: none;
  border-radius: 4px;
  padding: 12px 22px;
  background-color: #0473ea;
  color: #ffffff;
  cursor: pointer;
  font-weight: bold;
}

@media (max-width: 750px) {
  .loan-comments-page {
    padding: 15px;
  }

  .application-summary {
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .application-summary div {
    border-right: none;
    padding: 0;
  }

  .comment-card-header,
  .comment-details {
    flex-direction: column;
    gap: 12px;
  }

  .modify-button {
    width: 100%;
  }
}
