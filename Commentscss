/* ==============================
   COMMENTS PAGE
   ============================== */

.loan-comments-page {
  width: 100%;
  min-height: 100vh;
  padding: 32px;
  background-color: #d4d4d4;
  color: #001e8c;
  font-family: inherit;
  box-sizing: border-box;
}

.loan-comments-page * {
  box-sizing: border-box;
  font-family: inherit;
}

.loan-comments-container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

/* ==============================
   PAGE HEADING
   ============================== */

.comments-page-heading {
  margin-bottom: 28px;
}

.comments-page-heading h1 {
  margin: 0 0 8px;
  color: #001e8c;
  font-size: 32px;
  font-weight: bold;
}

.comments-page-heading p {
  margin: 0;
  color: #0473ea;
  font-size: 14px;
  line-height: 1.5;
}

/* ==============================
   APPLICATION SUMMARY CARD
   ============================== */

.application-summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-bottom: 30px;
  border: 1px solid #d4d4d4;
  border-radius: 8px;
  padding: 24px;
  background-color: #ffffff;
}

.application-summary div {
  display: flex;
  min-height: 58px;
  border-right: 1px solid #d4d4d4;
  padding: 0 22px;
  flex-direction: column;
  justify-content: center;
}

.application-summary div:first-child {
  padding-left: 0;
}

.application-summary div:last-child {
  border-right: none;
  padding-right: 0;
}

.application-summary span {
  margin-bottom: 9px;
  color: #001e8c;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.application-summary strong {
  color: #001e8c;
  font-size: 15px;
  font-weight: bold;
}

.application-summary .summary-status {
  color: #d50000;
}

/* ==============================
   MAKER COMMENTS HEADING
   ============================== */

.maker-comments-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.maker-comments-heading h2 {
  margin: 0;
  color: #001e8c;
  font-size: 24px;
  font-weight: bold;
}

.maker-comments-heading span {
  border-radius: 14px;
  padding: 6px 14px;
  background-color: #0473ea;
  color: #ffffff;
  font-size: 12px;
  font-weight: bold;
}

/* ==============================
   COMMENTS LIST
   ============================== */

.comments-list {
  display: grid;
  gap: 20px;
}

/* ==============================
   INDIVIDUAL COMMENT CARD
   ============================== */

.comment-card {
  border: 1px solid #d4d4d4;
  border-radius: 8px;
  padding: 25px;
  background-color: #ffffff;
}

.comment-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.comment-card-header h3 {
  margin: 0 0 9px;
  color: #001e8c;
  font-size: 18px;
  font-weight: bold;
}

.maker-badge {
  display: inline-block;
  border-radius: 12px;
  padding: 5px 11px;
  background-color: #0473ea;
  color: #ffffff;
  font-size: 11px;
  font-weight: bold;
}

.comment-date {
  margin: 0;
  color: #0473ea;
  font-size: 13px;
}

/* ==============================
   COMMENT MESSAGE
   ============================== */

.comment-message {
  margin: 22px 0;
  border: 1px solid #d4d4d4;
  border-radius: 4px;
  padding: 17px;
  background-color: #ffffff;
  color: #001e8c;
  font-size: 15px;
  line-height: 1.6;
}

/* ==============================
   COMMENT DETAILS
   ============================== */

.comment-details {
  display: flex;
  gap: 35px;
  align-items: center;
}

.comment-details p {
  margin: 0;
  color: #001e8c;
  font-size: 14px;
}

.comment-details strong {
  color: #001e8c;
}

.action-status {
  color: #d50000;
  font-weight: bold;
}

/* ==============================
   MODIFY APPLICATION BUTTON
   ============================== */

.modify-button {
  display: block;
  min-width: 190px;
  margin-top: 24px;
  margin-left: auto;
  border: 2px solid #05561c;
  border-radius: 4px;
  padding: 12px 24px;
  background-color: #05561c;
  color: #ffffff;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
  font-weight: bold;
  letter-spacing: 0.4px;
}

.modify-button:hover {
  border-color: #38d200;
  background-color: #38d200;
  color: #001e8c;
}

.modify-button:active {
  border-color: #001e8c;
  background-color: #001e8c;
  color: #ffffff;
}

.modify-button:focus {
  outline: 3px solid #82f028;
  outline-offset: 2px;
}

/* ==============================
   NO COMMENTS
   ============================== */

.no-comments {
  border: 1px solid #d4d4d4;
  border-radius: 8px;
  padding: 40px;
  background-color: #ffffff;
  color: #001e8c;
  text-align: center;
}

.no-comments h3 {
  margin: 0 0 10px;
  color: #001e8c;
  font-size: 18px;
}

.no-comments p {
  margin: 0;
  color: #0473ea;
  font-size: 14px;
}

/* ==============================
   RESPONSIVE DESIGN
   ============================== */

@media (max-width: 750px) {
  .loan-comments-page {
    padding: 15px;
  }

  .comments-page-heading h1 {
    font-size: 26px;
  }

  .application-summary {
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }

  .application-summary div {
    border-right: none;
    padding: 0;
  }

  .comment-card-header {
    gap: 12px;
    flex-direction: column;
  }

  .comment-details {
    gap: 12px;
    align-items: flex-start;
    flex-direction: column;
  }

  .modify-button {
    width: 100%;
  }
}

@media (max-width: 480px) {
  .application-summary {
    grid-template-columns: 1fr;
  }

  .maker-comments-heading {
    gap: 12px;
    align-items: flex-start;
    flex-direction: column;
  }
}
.edit-mode-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
  border: 1px solid #d4d4d4;
  border-radius: 8px;
  padding: 16px 20px;
  background-color: #ffffff;
}

.edit-mode-toolbar p {
  margin: 0;
  color: #001e8c;
  font-size: 14px;
}

.edit-mode-toolbar strong {
  color: #0473ea;
}

.exit-edit-button {
  border: 1px solid #0473ea;
  border-radius: 4px;
  padding: 11px 20px;
  background-color: #ffffff;
  color: #0473ea;
  cursor: pointer;
  font-family: inherit;
  font-size: 14px;
  font-weight: bold;
}

.exit-edit-button:hover {
  background-color: #0473ea;
  color: #ffffff;
}

.exit-edit-button:active {
  background-color: #001e8c;
  color: #ffffff;
}

.exit-edit-button:focus {
  outline: 3px solid #52daff;
  outline-offset: 2px;
}

@media (max-width: 700px) {
  .edit-mode-toolbar {
    gap: 15px;
    align-items: flex-start;
    flex-direction: column;
  }

  .exit-edit-button {
    width: 100%;
  }
}
/* ========================================
   ALL COMMENTS DASHBOARD PAGE
======================================== */

.all-comments-page {
  min-height: 100vh;
  padding: 32px;
  background-color: #f5f6f8;
  color: #001e8c;
  font-family: inherit;
  box-sizing: border-box;
}

.all-comments-container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

/* Page heading */

.all-comments-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
}

.all-comments-heading h1 {
  margin: 0 0 8px;
  color: #001e8c;
  font-size: 32px;
  font-weight: 700;
}

.all-comments-heading p {
  margin: 0;
  color: #555555;
  font-size: 15px;
  line-height: 1.5;
}

.comments-count {
  display: inline-block;
  padding: 8px 14px;
  background-color: #eaf4ff;
  color: #0473ea;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
}

/* Table outer card */

.comments-table-container {
  width: 100%;
  overflow-x: auto;
  background-color: #ffffff;
  border: 1px solid #d4d4d4;
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(0, 30, 140, 0.08);
}

/* Table */

.comments-table {
  width: 100%;
  min-width: 700px;
  border-collapse: collapse;
}

.comments-table th {
  padding: 16px 20px;
  background-color: #001e8c;
  color: #ffffff;
  font-size: 14px;
  font-weight: 600;
  text-align: left;
}

.comments-table th:first-child {
  border-top-left-radius: 8px;
}

.comments-table th:last-child {
  border-top-right-radius: 8px;
}

.comments-table td {
  padding: 18px 20px;
  color: #1c1c1c;
  font-size: 14px;
  border-bottom: 1px solid #d4d4d4;
}

.comments-table tbody tr:last-child td {
  border-bottom: none;
}

.comments-table tbody tr:hover {
  background-color: #f4f9ff;
}

/* Status */

.comment-status {
  display: inline-block;
  padding: 7px 12px;
  background-color: #eaf4ff;
  color: #001e8c;
  border-radius: 16px;
  font-size: 13px;
  font-weight: 600;
}

/* View Comments button */

.view-comments-button {
  min-width: 130px;
  padding: 10px 16px;
  background-color: #0473ea;
  color: #ffffff;
  border: none;
  border-radius: 4px;
  font-family: inherit;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition:
    background-color 0.2s ease,
    transform 0.2s ease;
}

.view-comments-button:hover {
  background-color: #001e8c;
  transform: translateY(-1px);
}

.view-comments-button:active {
  transform: translateY(0);
}

.view-comments-button:focus {
  outline: 2px solid #52daff;
  outline-offset: 2px;
}

/* Empty message */

.no-comments-message {
  padding: 30px;
  margin: 0;
  background-color: #ffffff;
  color: #555555;
  border: 1px solid #d4d4d4;
  border-radius: 8px;
  font-size: 15px;
  text-align: center;
}

/* Mobile screen */

@media screen and (max-width: 768px) {
  .all-comments-page {
    padding: 20px 16px;
  }

  .all-comments-heading {
    flex-direction: column;
    align-items: flex-start;
  }

  .all-comments-heading h1 {
    font-size: 26px;
  }

  .comments-table th,
  .comments-table td {
    padding: 14px;
  }
}



