function CommentCard({ comment, handleModify }) {
  return (
    <div className="comment-card">
      <div className="comment-card-header">
        <div>
          <h3>{comment.sender}</h3>
          <span className="maker-badge">
            {comment.role}
          </span>
        </div>

        <p className="comment-date">
          {comment.date}
        </p>
      </div>

      <p className="comment-message">
        {comment.message}
      </p>

      <div className="comment-details">
        <p>
          <strong>Modification Section:</strong>{" "}
          {comment.modificationSection}
        </p>

        <p>
          <strong>Status:</strong>{" "}
          <span className="action-status">
            Action Required
          </span>
        </p>
      </div>

      {comment.status === "ACTION_REQUIRED" && (
        <button
          type="button"
          className="modify-button"
          onClick={() => handleModify(comment)}
