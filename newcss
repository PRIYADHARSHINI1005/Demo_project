/* ==============================
   MAIN PAGE
   ============================== */

.loan-application-page {
  width: 100%;
  min-height: 100vh;
  padding: 32px;
  background-color: #d4d4d4;
  color: #001e8c;
  box-sizing: border-box;
}

.loan-application-page * {
  box-sizing: border-box;
}

.loan-application-container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

.loan-application-container > h1 {
  margin: 0 0 28px;
  color: #001e8c;
  font-size: 32px;
}

/* ==============================
   APPLICATION STEPPER
   ============================== */

.stepper {
  display: flex;
  width: 100%;
  align-items: flex-start;
  margin-bottom: 30px;
  padding: 22px 10px;
  background-color: #ffffff;
}

.step-section {
  display: flex;
  width: 125px;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.step-section p {
  margin: 9px 0 0;
  color: #d4d4d4;
  font-size: 12px;
  font-weight: bold;
}

.step-circle {
  display: flex;
  width: 36px;
  height: 36px;
  align-items: center;
  justify-content: center;
  border: 2px solid #d4d4d4;
  border-radius: 50%;
  background-color: #ffffff;
  color: #d4d4d4;
  cursor: pointer;
  font-size: 13px;
  font-weight: bold;
}

.step-circle.current {
  border-color: #0473ea;
  background-color: #ffffff;
  color: #0473ea;
}

.step-circle.completed {
  border-color: #0473ea;
  background-color: #0473ea;
  color: #ffffff;
}

.step-circle.current:hover {
  background-color: #52daff;
  color: #001e8c;
}

.step-circle.completed:hover {
  border-color: #001e8c;
  background-color: #001e8c;
}

.step-circle:disabled {
  opacity: 1;
  cursor: not-allowed;
}

.step-circle.current + p,
.step-circle.completed + p {
  color: #001e8c;
}

.step-line {
  height: 2px;
  flex: 1;
  margin-top: 17px;
  background-color: #d4d4d4;
}

.completed-line {
  background-color: #0473ea;
}

/* ==============================
   FORM CARD
   ============================== */

.loan-application-container > form {
  overflow: hidden;
  border: 1px solid #d4d4d4;
  border-radius: 8px;
  background-color: #ffffff;
}

.form-step {
  padding: 30px;
}

.form-step h2 {
  margin: 0 -30px;
  border-bottom: 1px solid #d4d4d4;
  padding: 0 30px 22px;
  color: #001e8c;
  font-size: 24px;
}

.form-step > p {
  margin: 20px 0 25px;
  color: #0473ea;
  font-size: 14px;
}

/* ==============================
   FORM FIELDS
   ============================== */

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px 32px;
}

.form-group {
  display: flex;
  flex-direction: column;
}

.form-group label {
  margin-bottom: 8px;
  color: #001e8c;
  font-size: 12px;
  font-weight: bold;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  border: 1px solid #d4d4d4;
  border-radius: 3px;
  padding: 13px;
  background-color: #ffffff;
  color: #001e8c;
  font-family: inherit;
  font-size: 15px;
  outline: none;
}

.form-group input:hover,
.form-group select:hover,
.form-group textarea:hover {
  border-color: #52daff;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
  border: 2px solid #0473ea;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
  color: #d4d4d4;
}

.form-group textarea {
  min-height: 90px;
  resize: vertical;
}

.form-group select {
  cursor: pointer;
}

.full-width {
  grid-column: 1 / -1;
}

/* Browser validation */

.form-group input:invalid:focus,
.form-group select:invalid:focus,
.form-group textarea:invalid:focus {
  border-color: #d50000;
}

/* ==============================
   DOCUMENT UPLOAD
   ============================== */

.document-list {
  display: grid;
  gap: 20px;
}

.document-group {
  border: 2px dashed #d4d4d4;
  border-radius: 6px;
  padding: 20px;
  background-color: #ffffff;
}

.document-group:hover {
  border-color: #52daff;
}

.document-group label {
  display: block;
  margin-bottom: 12px;
  color: #001e8c;
  font-size: 13px;
  font-weight: bold;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.document-group input {
  width: 100%;
  color: #001e8c;
}

.document-group input::file-selector-button {
  margin-right: 15px;
  border: 1px solid #0473ea;
  border-radius: 3px;
  padding: 10px 16px;
  background-color: #0473ea;
  color: #ffffff;
  cursor: pointer;
  font-weight: bold;
}

.document-group input::file-selector-button:hover {
  border-color: #001e8c;
  background-color: #001e8c;
}

.file-name {
  margin: 12px 0 0;
  color: #05561c;
  font-size: 14px;
  font-weight: bold;
}

/* ==============================
   REVIEW APPLICATION
   ============================== */

.review-section {
  margin-top: 20px;
  border: 1px solid #d4d4d4;
  border-left: 5px solid #0473ea;
  border-radius: 3px;
  padding: 20px;
  background-color: #ffffff;
}

.review-section h3 {
  margin: 0 0 16px;
  color: #0473ea;
  font-size: 18px;
}

.review-section p {
  margin: 10px 0;
  color: #001e8c;
  line-height: 1.5;
}

.declaration {
  display: flex;
  gap: 10px;
  align-items: center;
  margin-top: 25px;
  border: 1px solid #ffc120;
  border-radius: 3px;
  padding: 15px;
  background-color: #ffffff;
}

.declaration input {
  width: 18px;
  height: 18px;
  accent-color: #38d200;
  cursor: pointer;
}

.declaration label {
  color: #001e8c;
  cursor: pointer;
}

/* ==============================
   BOTTOM NAVIGATION
   ============================== */

.form-navigation {
  display: flex;
  width: 100%;
  align-items: center;
  border-top: 1px solid #d4d4d4;
  padding: 20px 30px;
  background-color: #ffffff;
}

/* Back button */

.back-button {
  min-width: 110px;
  border: 1px solid #0473ea;
  border-radius: 4px;
  padding: 12px 22px;
  background-color: #ffffff;
  color: #0473ea;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
}

.back-button:hover {
  background-color: #52daff;
  color: #001e8c;
}

.back-button:active {
  background-color: #0473ea;
  color: #ffffff;
}

.back-button:disabled {
  visibility: hidden;
}

/* Proceed and Submit button */

.next-button {
  min-width: 150px;
  margin-left: auto;
  border: 2px solid #05561c;
  border-radius: 4px;
  padding: 12px 25px;
  background-color: #05561c;
  color: #ffffff;
  cursor: pointer;
  font-size: 14px;
  font-weight: bold;
  letter-spacing: 0.4px;
}

.next-button:hover {
  border-color: #38d200;
  background-color: #38d200;
  color: #001e8c;
}

.next-button:active {
  border-color: #001e8c;
  background-color: #001e8c;
  color: #ffffff;
}

.next-button:focus {
  outline: 3px solid #82f028;
  outline-offset: 2px;
}

/* ==============================
   SUCCESS PAGE
   ============================== */

.success-page {
  display: flex;
  width: 100%;
  min-height: 600px;
  align-items: center;
  justify-content: center;
  padding: 30px;
  background-color: #d4d4d4;
}

.success-card {
  width: 100%;
  max-width: 550px;
  border: 1px solid #d4d4d4;
  border-top: 7px solid #38d200;
  border-radius: 8px;
  padding: 40px;
  background-color: #ffffff;
  color: #001e8c;
  text-align: center;
}

.success-card h1 {
  margin-top: 0;
  color: #05561c;
}

.success-card strong {
  color: #0473ea;
}

/* ==============================
   RESPONSIVE DESIGN
   ============================== */

@media (max-width: 700px) {
  .loan-application-page {
    padding: 15px;
  }

  .loan-application-container > h1 {
    font-size: 26px;
  }

  .stepper {
    padding: 18px 5px;
  }

  .step-section {
    width: 75px;
  }

  .step-section p {
    font-size: 9px;
  }

  .step-circle {
    width: 30px;
    height: 30px;
  }

  .step-line {
    margin-top: 14px;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .full-width {
    grid-column: auto;
  }

  .form-step {
    padding: 20px;
  }

  .form-step h2 {
    margin: 0 -20px;
    padding: 0 20px 18px;
    font-size: 21px;
  }

  .form-navigation {
    padding: 16px 20px;
  }

  .back-button,
  .next-button {
    min-width: auto;
    padding: 11px 17px;
  }
}
