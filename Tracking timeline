function TrackingTimeline({ events, onViewComments }) {
  function formatDate(dateValue) {
    if (!dateValue) {
      return "Pending";
    }

    return new Date(dateValue).toLocaleString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });
  }

  function getStatusIcon(status) {
    if (status === "completed") {
      return "✓";
    }

    if (status === "current") {
      return "●";
    }

    if (status === "action-required") {
      return "!";
    }

    return "";
  }

  return (
    <section className="tracking-timeline-card">
      <div className="tracking-timeline-heading">
        <h2>Application Progress</h2>

        <p>
          Track the progress and latest updates of your loan application.
        </p>
      </div>

      <div className="tracking-timeline">
        {events.map((event, index) => (
          <div className="tracking-event" key={event.id}>
            <div className="tracking-event-marker">
              <div
                className={`tracking-event-circle tracking-event-${event.status}`}
              >
                {getStatusIcon(event.status)}
              </div>

              {index < events.length - 1 && (
                <div
                  className={`tracking-event-line tracking-line-${event.status}`}
                />
              )}
            </div>

            <div className="tracking-event-content">
              <div className="tracking-event-top">
                <div>
                  <h3>{event.title}</h3>

                  <span className="tracking-event-actor">
                    {event.actor}
                  </span>
                </div>

                <span className="tracking-event-date">
                  {formatDate(event.timestamp)}
                </span>
              </div>

              <p>{event.description}</p>

              {event.showCommentsAction && (
                <button
                  type="button"
                  className="tracking-comments-button"
                  onClick={() => onViewComments(event.commentId)}
                >
                  View Comments
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}

export default TrackingTimeline;
