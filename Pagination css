.comments-table-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;

  padding: 14px 24px;
  color: #666666;
  background-color: #ffffff;
  border-top: 1px solid #d4d4d4;

  font-family: inherit;
  font-size: 13px;
}

.comments-pagination {
  display: flex;
  align-items: center;
  gap: 6px;
}

.comments-pagination button {
  min-width: 34px;
  height: 34px;
  padding: 0 10px;

  background-color: #ffffff;
  color: #001e8c;
  border: 1px solid #d4d4d4;
  border-radius: 4px;

  font-family: inherit;
  font-size: 13px;
  cursor: pointer;
}

.comments-pagination button:hover:not(:disabled) {
  background-color: #eaf4ff;
  border-color: #0473ea;
}

.comments-pagination .active-page {
  background-color: #0473ea;
  color: #ffffff;
  border-color: #0473ea;
}

.comments-pagination button:disabled {
  color: #aaaaaa;
  background-color: #f5f5f5;
  cursor: not-allowed;
}

@media screen and (max-width: 768px) {
  .comments-table-footer {
    flex-direction: column;
    align-items: flex-start;
  }
}
